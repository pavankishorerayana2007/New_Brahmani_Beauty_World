# ============================================================
# Copy this file to ".env" (same folder) and fill in real values.
# NEVER commit ".env" to GitHub. On Vercel, add these in
# Project -> Settings -> Environment Variables instead.
# ============================================================

NODE_ENV=development
PORT=5000

# Public URL of the site. Used for CORS / origin checks.
# Local: http://localhost:5000   Production: https://your-project.vercel.app
FRONTEND_URL=http://localhost:5000

# --- Supabase (Project Settings -> API, and -> Database) ---
SUPABASE_URL=YOUR_SUPABASE_PROJECT_URL
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
# Postgres connection string. Use the "Transaction pooler" string on Vercel.
# Project Settings -> Database -> Connection string -> URI (replace [YOUR-PASSWORD])
DATABASE_URL=postgresql://postgres.xxxx:YOUR-PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres

# --- Auth ---
# Long random string (32+ chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=YOUR_STRONG_RANDOM_SECRET

# --- Owner account (only ONE owner can exist) ---
OWNER_EMAIL=pavan@gmail.com
SHOP_NAME=New Brahmani Beauty World
# Used ONLY by "npm run owner:seed" to create the owner once. 10+ characters.
# Remove it from .env (and never put it on Vercel) after seeding.
OWNER_INITIAL_PASSWORD=CHOOSE_A_STRONG_PASSWORD
OWNER_NAME=Pavan

# --- Email for "Forgot password" OTP (optional; any SMTP, e.g. Gmail app password) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
